// server.js

const express = require('express');
const cors = require('cors'); // Import the cors middleware
const app = express();
const PORT = 3002;

// --- CORS Configuration ---
// This middleware allows your frontend (http://localhost:3001) to make requests
// to this backend (http://localhost:3002).
// In a production environment, you should replace '*' with your specific frontend origin,
// e.g., 'http://localhost:3001' or 'https://your-frontend-domain.com'.
const corsOptions = {
    origin: 'http://localhost:3001', // Allow requests only from your frontend URL
    methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS'], // Allowed HTTP methods
    allowedHeaders: ['Content-Type', 'Authorization'], // Allowed request headers
    credentials: true // Allow cookies to be sent (if applicable, though not strictly needed for token auth)
};
app.use(cors(corsOptions));

// --- Middleware to parse JSON request bodies ---
// This line tells Express to parse incoming requests with JSON payloads.
// This is necessary to access `req.body` in your POST endpoint.
app.use(express.json());

// --- API Endpoint: Perform Sensitive Transaction ---
// This endpoint handles POST requests to '/api/perform-sensitive-transaction'.
app.post('/api/perform-sensitive-transaction', (req, res) => {
    console.log('--- Received Request to /api/perform-sensitive-transaction ---');
    console.log('Request Body:', req.body);
    console.log('Authorization Header:', req.headers.authorization);

    // In a real application, you would:
    // 1. Validate the Access Token received in the 'Authorization' header.
    //    (e.g., using an Okta JWT Verifier library or a middleware)
    // 2. Perform the sensitive transaction logic.
    // 3. Return an appropriate response based on the outcome.

    // For this example, we'll just simulate a successful transaction.
    const transactionData = req.body; // The data sent from the frontend

    // You can add basic validation here if needed
    if (!transactionData || !transactionData.productId || !transactionData.quantity) {
        return res.status(400).json({
            status: 'error',
            message: 'Invalid transaction data. Missing productId or quantity.'
        });
    }

    // Simulate processing the transaction
    const transactionId = `txn_${Date.now()}`;
    const responseMessage = `Transaction ${transactionId} processed successfully for product ${transactionData.productId}.`;

    console.log('--- Responding with Success ---');
    res.status(200).json({
        status: 'success',
        message: responseMessage,
        transactionId: transactionId,
        receivedData: transactionData,
        // You might include some details from the token if you parsed it
        // e.g., userId: 'user123'
    });
});

// --- Basic Root Endpoint (Optional) ---
// A simple GET endpoint for testing if the server is running.
app.get('/', (req, res) => {
    res.send('Okta API Service is running!');
});

// --- Start the Server ---
app.listen(PORT, () => {
    console.log(`API Server is running on http://localhost:${PORT}`);
    console.log(`Frontend should be at http://localhost:3001`);
});
